# =============================================================================
# Balam Xchange — backend/.env
# Copia este archivo: cp backend/.env.example backend/.env
# =============================================================================

# --- Servidor (obligatorias; siempre se leen desde .env) ---------------------

# Puerto HTTP + WebSocket (ws://localhost:PORT/ws)
PORT=3001

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Producción (opcional) ---------------------------------------------------

# NODE_ENV=production

# --- Semilla inicial de SQLite (opcional) ------------------------------------
# demoMode, autoExecute, umbrales, etc. viven en backend/data/settings.sqlite.
# Estas variables solo aplican la PRIMERA vez (si la clave no existe en SQLite).
# Después: panel ⚙ Configuración o PATCH /api/settings
# Para re-sembrar desde .env: borra backend/data/settings.sqlite y reinicia.

# DEMO_MODE=false
# AUTO_EXECUTE=true
# POLL_INTERVAL_MS=1500
# MIN_NET_PROFIT_PCT=0.02
# MIN_VOLUME_BTC=0.001
# MAX_COMBINED_LATENCY_MS=2000
# CIRCUIT_BREAKER_THRESHOLD=3
# CIRCUIT_BREAKER_COOLDOWN_MS=60000
