# Variables para Coolify (copiar en Environment Variables del servicio)
# Build: Dockerfile en la raíz del repo
# Puerto del contenedor: 3001
# Health check: GET /health

NODE_ENV=production
PORT=3001

# En Coolify: NODE_ENV → solo "Runtime" (NO Buildtime), o el build falla sin tsc/vite.

# URL pública (sin barra final)
CORS_ORIGIN=https://balam-xchange.grupokamar.com.mx

# Semilla inicial SQLite (solo la primera vez, antes de crear settings.sqlite)
DEMO_MODE=true

# Ruta dentro del contenedor — monta volumen persistente en /app/backend/data
SETTINGS_DB_PATH=/app/backend/data/settings.sqlite

# Producción: sin order books mock si falla un exchange
STRICT_LIVE=true

# Fallback USDT→USD si Kraken no responde (feed live cada ~60 s)
FX_USDT_USD_RATE=1

# Opcional: si Binance global (451) falla, el backend prueba Binance.US automáticamente.
# BINANCE_DEPTH_URL=https://api.binance.us/api/v3/depth?symbol=BTCUSDT&limit=10
